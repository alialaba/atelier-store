# Neon Postgres connection string (Neon console → Connect).
# Use the pooled connection string; append ?sslmode=require if not present.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of this app
BETTER_AUTH_URL="http://localhost:3000"
